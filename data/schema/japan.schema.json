{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "日本",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "areas": {
      "type": "array",
      "description": "八大地方",
      "items": {
        "type": "object",
        "properties": {
          "k": { "type": "string", "pattern": "^[a-z]{2}$", "description": "地方代碼" },
          "n": { "type": "string", "minLength": 1, "description": "地方名稱" },
          "c": { "$ref": "common.schema.json#/$defs/code", "description": "地圖色票使用的區域代碼" }
        },
        "required": ["k", "n", "c"],
        "additionalProperties": false
      }
    },
    "prefectures": {
      "type": "array",
      "description": "47 都道府縣",
      "minItems": 47,
      "maxItems": 47,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(0[1-9]|[1-3]\\d|4[0-7])$", "description": "JIS 都道府縣碼 01～47，對應日本地圖" },
          "n": { "type": "string", "minLength": 1, "description": "縣名" },
          "a": { "type": "string", "pattern": "^[a-z]{2}$", "description": "地方代碼，對應 areas" },
          "s": { "$ref": "common.schema.json#/$defs/names", "minItems": 1, "description": "景點" },
          "h": { "$ref": "common.schema.json#/$defs/names", "description": "遺跡・史蹟" },
          "wh": { "$ref": "common.schema.json#/$defs/names", "description": "世界遺產（沒有時給空陣列）" },
          "ev": { "type": "array", "description": "祭典活動，可省略 c；t 預設為 F", "items": { "$ref": "common.schema.json#/$defs/event" } }
        },
        "required": ["id", "n", "a", "s", "h", "wh", "ev"],
        "additionalProperties": false
      }
    },
    "national": {
      "type": "array",
      "description": "日本國定假日與全國性傳統節日",
      "items": { "$ref": "common.schema.json#/$defs/event", "required": ["t"] }
    }
  },
  "required": ["areas", "prefectures", "national"],
  "additionalProperties": false
}
