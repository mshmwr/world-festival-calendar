{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "每月推薦景點與行程",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "sourceNames": {
      "type": "object",
      "description": "來源網域對應的顯示名稱，例如 \"liontravel.com\": \"雄獅旅遊\"。子網域會自動對應到主網域",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "picks": {
      "type": "object",
      "description": "key 為月份（1～12），值為以國家代碼為 key 的推薦清單",
      "propertyNames": { "pattern": "^([1-9]|1[0-2])$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[A-Z]{2,3}$" },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "n": { "type": "string", "minLength": 1, "description": "景點或行程名稱" },
              "pop": { "enum": [1, 2, 3], "description": "熱門程度：3 多家旅行社當月行程都有排或當月最具代表性；2 一兩家旅行社或主要旅遊網站推薦；1 旅遊局或攻略推薦、團體行程少見" },
              "x": { "type": "string", "minLength": 1, "description": "為什麼這個月適合去，一兩句自己的話" },
              "p": { "type": "string", "pattern": "^(0[1-9]|[1-3]\\d|4[0-7])$", "description": "日本專用：所在都道府縣代碼（選填）" },
              "src": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "資料來源網址（旅行社行程或專題、旅遊局、旅遊網站）",
                "items": { "type": "string", "pattern": "^https://" }
              }
            },
            "required": ["n", "pop", "x", "src"],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "required": ["sourceNames", "picks"],
  "additionalProperties": false
}
